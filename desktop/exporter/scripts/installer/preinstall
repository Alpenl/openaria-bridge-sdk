#!/bin/sh
set -eu
# Installer scripts must never configure a different target volume.
[ "${3:-/}" = / ] || { echo 'Only the running system volume is supported' >&2; exit 1; }
config=/Library/PrivilegedHelperTools/dev.alpen.openaria-exporter.uid
if [ -e "$config" ] || [ -L "$config" ]; then
 [ ! -L "$config" ] && [ -f "$config" ] || exit 1
 [ "$(/usr/bin/stat -f %u "$config")" = 0 ] || exit 1
 mode=$(/usr/bin/stat -f %Lp "$config")
 [ "$mode" = 600 ] || { echo 'UID config permissions must be 600' >&2; exit 1; }
 uid=$(/bin/cat "$config")
else
 uid=$(/usr/bin/stat -f %u /dev/console)
fi
case "$uid" in ''|*[!0-9]*|0|4294967295) echo 'A valid non-root console user is required' >&2; exit 1;; esac
/usr/bin/id -nu "$uid" >/dev/null || exit 1
# Stop only our service; absence on first install is expected.
/bin/launchctl bootout system/dev.alpen.openaria-exporter 2>/dev/null || true
