$oa-background: #151719;
$oa-surface: #202428;
$oa-panel: #252a2f;
$oa-border: #3b4349;
$oa-text: #e8ecef;
$oa-muted: #9ba5ad;
$oa-accent: #4fa37c;
$oa-warning: #d9aa52;
$oa-danger: #d36d6d;

Screen {
    background: $oa-background;
    color: $oa-text;
}

Header {
    background: #1d2124;
    color: $oa-text;
}

#shell {
    height: 1fr;
}

#status-bar {
    height: 2;
    margin: 1 2 0 2;
    padding: 0 1;
    background: $oa-surface;
    content-align: left middle;
}

#activity {
    width: 5;
    height: 1;
    margin-right: 1;
    color: $oa-accent;
}

#status-message {
    width: 1fr;
    height: 1;
    color: $oa-muted;
    text-overflow: ellipsis;
    overflow: hidden hidden;
}

#status-message.error {
    color: $oa-danger;
}

#workspace {
    height: 1fr;
    padding: 1 2 0 2;
}

.pane {
    height: 1fr;
    padding: 0 1;
    background: $oa-panel;
    border: solid $oa-border;
    border-title-color: $oa-text;
    border-title-style: bold;
}

#source-pane {
    width: 37;
    margin-right: 1;
}

#sessions-pane {
    width: 1fr;
}

#source-summary,
#session-summary {
    height: 2;
    padding: 0 1;
    color: $oa-muted;
    content-align: left middle;
}

#sources,
#sessions {
    height: 1fr;
    border: none;
    background: transparent;
}

#sources > .option-list--option-highlighted,
#sessions > .option-list--option-highlighted {
    background: #344039;
    color: $oa-text;
}

#connect {
    width: 100%;
    height: 3;
    margin-top: 1;
}

#unavailable-summary {
    height: 2;
    padding: 0 1;
    color: $oa-warning;
}

#transfer-bar {
    height: 5;
    margin: 1 2;
    padding: 0 1;
    background: $oa-surface;
    content-align: left middle;
}

#destination {
    width: 1fr;
    height: 3;
}

#destination-label {
    height: 1;
    color: $oa-muted;
}

#destination-path {
    height: 2;
    text-overflow: ellipsis;
    overflow: hidden hidden;
}

#change-output {
    width: 14;
    height: 3;
    margin: 0 1;
}

#export {
    min-width: 27;
    width: auto;
    height: 3;
}

Footer {
    background: #1d2124;
}

TextEntryDialog {
    align: center middle;
    background: #000000 55%;
}

#entry-dialog {
    width: 64;
    height: 15;
    padding: 1 2;
    background: $oa-panel;
    border: solid $oa-border;
}

#entry-title {
    height: 2;
    text-style: bold;
    color: $oa-text;
}

#entry-label {
    height: 1;
    color: $oa-muted;
}

#entry-input {
    margin-top: 1;
}

#entry-error {
    height: 2;
    color: $oa-danger;
}

#entry-actions {
    height: 3;
    align-horizontal: right;
}

#entry-cancel,
#entry-submit {
    width: 16;
    margin-left: 1;
}

Screen.-narrow #workspace {
    layout: vertical;
}

Screen.-narrow #status-bar {
    height: 1;
    margin: 0 2;
    padding: 0 1;
}

Screen.-narrow #activity {
    display: none;
}

Screen.-narrow #source-pane {
    width: 100%;
    height: 6;
    margin: 0 0 1 0;
}

Screen.-narrow #source-summary {
    display: none;
}

Screen.-narrow #sessions-pane {
    width: 100%;
    height: 1fr;
}

Screen.-narrow #connect {
    display: none;
}

Screen.-narrow #transfer-bar {
    height: 6;
    layout: vertical;
    padding: 0 1 1 1;
}

Screen.-narrow #destination {
    width: 100%;
    height: 2;
}

Screen.-narrow #destination-label {
    display: none;
}

Screen.-narrow #change-output {
    display: none;
}

Screen.-narrow #export {
    width: 100%;
    height: 3;
}

Screen.-narrow #entry-dialog {
    width: 92%;
}
