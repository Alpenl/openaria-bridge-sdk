$oa-bg: #171918;
$oa-surface: #222524;
$oa-text: #dcdedd;
$oa-muted: #929596;
$oa-border: #3a403d;
$oa-accent: #8cc9bd;
$oa-error: #ed9b9b;

Screen {
    background: $oa-bg;
    color: $oa-text;
    align-horizontal: center;
}

#workbench {
    width: 100%;
    max-width: 160;
    height: 1fr;
    padding: 0 3;
}

#masthead { height: 3; align-vertical: middle; }
#brand { width: 12; height: 1; text-style: bold; color: $oa-accent; }
#subtitle { width: 1fr; height: 1; color: $oa-muted; }
#connection-state { width: 12; height: 1; text-align: right; color: $oa-accent; }
#source-bar { height: 1; }
#sources { width: 1fr; height: 1; margin-right: 1; background: $oa-surface; border: none; }
SelectCurrent { border: none; background: $oa-surface; }
SelectOverlay { background: $oa-surface; border: solid $oa-border; padding: 0; }

Button {
    background: $oa-surface;
    color: $oa-text;
    border: none;
    min-width: 6;
    height: 3;
    padding: 0 1;
    text-style: none;
}
Button:hover, Button:focus { background: #38413d; color: white; text-style: bold; }
Button:disabled { opacity: 45%; }
#rescan { width: 5; min-width: 5; height: 1; margin-right: 1; }
#connect { width: 10; height: 1; }

#views { height: 2; margin: 1 0 0 0; }
Tabs, Tab { background: transparent; }
Tab { color: $oa-muted; padding: 0 2; }
Tab.-active { color: $oa-text; text-style: bold; }
Underline > .underline--bar { color: $oa-accent; background: $oa-border; }

#content, #recordings, #activity-view { height: 1fr; }
#filter-bar { height: 1; }
#filter { width: 1fr; border: none; padding: 0 1; height: 1; background: $oa-surface; }
#select-all { width: 8; height: 1; margin-left: 1; }
#select-exported { width: 12; height: 1; margin-left: 1; }
#delete { width: 8; height: 1; margin-left: 1; color: $oa-error; }
#session-summary, #log-heading {
    height: 1;
    color: $oa-muted;
    text-overflow: ellipsis;
    text-wrap: nowrap;
}
#sessions {
    height: 1fr;
    border: none;
    padding: 0;
    background: transparent;
    scrollbar-size: 1 1;
}
#sessions > .option-list--option { padding: 0; }
#sessions > .option-list--option-highlighted { background: #303c37; color: $oa-text; text-style: none; }
#sessions > .option-list--option-disabled { color: $oa-muted; }
#sessions > .selection-list--button-selected { color: $oa-accent; background: transparent; }
#sessions > .selection-list--button-selected-highlighted { color: $oa-accent; background: transparent; }
#sessions > .selection-list--button, #sessions > .selection-list--button-highlighted {
    color: $oa-bg;
    background: $oa-bg;
}
#empty-state { height: 1fr; content-align: center middle; color: $oa-muted; }
#session-detail { height: 2; color: $oa-muted; text-overflow: ellipsis; overflow: hidden hidden; }
#activity-log { height: 1fr; background: transparent; border: none; padding: 0; scrollbar-size: 1 1; }

#transfer-bar { height: auto; border-top: solid $oa-border; }
#destination-row { height: 1; }
#destination-path { width: 1fr; height: 1; text-overflow: ellipsis; text-wrap: nowrap; }
#change-output { height: 1; width: 8; margin-left: 1; }
#export-row { height: 3; align-vertical: middle; }
#selection-summary { width: 1fr; height: auto; max-height: 3; }
#export { width: 16; background: $oa-accent; color: #171918; text-style: bold; margin-left: 1; }
#export:hover, #export:focus { background: #b1e2d6; }
#progress { height: 1; width: 1fr; }
#progress Bar { width: 1fr; }
#status-row { height: 1; }
#status-message { width: 1fr; height: 1; color: $oa-muted; text-wrap: nowrap; text-overflow: ellipsis; }
#status-message.error { color: $oa-error; }
#elapsed { width: 9; text-align: right; color: $oa-muted; }

Footer { background: $oa-surface; color: $oa-muted; }
Footer > .footer--key { background: transparent; color: $oa-accent; }

TextEntryDialog { align: center middle; background: #000000 55%; }
DeleteDialog { align: center middle; background: #000000 55%; }
#delete-dialog { width: 68; max-width: 94%; height: 22; max-height: 94%; padding: 1 2; border: solid $oa-border; background: $oa-surface; }
#delete-title { height: 2; text-style: bold; color: $oa-error; }
#delete-body { height: 1fr; scrollbar-size: 1 1; }
#delete-description { height: auto; }
#delete-warning { height: auto; margin-top: 1; color: $oa-error; }
#delete-actions { height: 3; align-horizontal: right; margin-top: 1; }
#delete-cancel, #delete-confirm { width: auto; min-width: 10; margin-left: 1; }
#delete-confirm { background: $oa-error; color: $oa-bg; }
#entry-dialog {
    width: 64;
    max-width: 94%;
    height: auto;
    padding: 1 2;
    border: solid $oa-border;
    background: $oa-surface;
}
#entry-title { height: 2; text-style: bold; color: $oa-accent; }
#entry-label { height: 1; color: $oa-muted; }
#entry-input { margin-top: 1; border: tall $oa-border; background: $oa-bg; }
#entry-input:focus { border: tall $oa-accent; }
#entry-error { height: auto; min-height: 1; max-height: 4; color: $oa-error; }
#entry-actions { height: 3; align-horizontal: right; }
#entry-cancel, #entry-submit { width: auto; min-width: 8; margin-left: 1; }
#entry-submit { color: $oa-bg; background: $oa-accent; }

Screen.-narrow #workbench { padding: 0 1; }
Screen.-narrow #subtitle { display: none; }
Screen.-narrow #brand { width: 1fr; }
Screen.-short #masthead { height: 1; }
Screen.-short #views { margin: 0; }
Screen.-short #session-detail { display: none; }
